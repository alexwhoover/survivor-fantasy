# Copy to .env and fill in. .env is gitignored.

# The site's single admin login — the only credential in the app. Visitors browse
# read-only and never sign in, so anyone with this can edit every league:
#   openssl rand -base64 24
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me

# Cloudflare Tunnel token. Only needed for the production profile;
# leave blank for local development.
TUNNEL_TOKEN=change-me
