# Copy to .env and fill in. .env is gitignored.

# Invite code required to register a new account.
APP_INVITE_CODE=change-me

# Secret for admin endpoints (POST /api/admin/reset-password, sent as the X-Admin-Key header).
# Anyone with it can reset any user's password, so generate a long random value:
#   openssl rand -hex 32
APP_ADMIN_KEY=change-me

# Cloudflare Tunnel token. Only needed for the production profile;
# leave blank for local development.
TUNNEL_TOKEN=change-me
